[Service]
# One filtered input for wake, local STT, and Nova; no global device changes.
ExecStartPre=@WORKDIR@/scripts/ensure-echo-cancel.sh
Environment=PIPEWIRE_NODE=hyusk_aec_source
Environment=HYUSK_SONIC_INPUT_DEVICE=hyusk_aec_source
Environment=HYUSK_OUTPUT_DEVICE=hyusk_aec_sink
Environment=PULSE_SINK=hyusk_aec_sink

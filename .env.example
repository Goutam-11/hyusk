# Copy this file to .env or export these variables in your shell.
# .env is ignored by Git and must not contain a committed API key.

OPENROUTER_API_KEY=
# Optional. Enables Brave Search API; without it, native search uses the
# keyless DuckDuckGo HTML endpoint.
# BRAVE_SEARCH_API_KEY=
# Fast paid, tool-capable model for low-latency voice turns. Free tiers are
# often queued and add seconds. Alternatives: google/gemini-2.0-flash-001,
# anthropic/claude-3.5-haiku, groq/llama-3.3-70b-versatile.
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Set to 0 for text-only models. When enabled, screenshots are attached to the
# next model turn as images instead of relying on OCR.
MODEL_VISION=1
# When 1, the orb requests keyboard focus while active. This can steal focus
# from the app the agent is controlling, so it defaults to 0.
ORB_STEAL_FOCUS=0
# Orb window: 0 = off, 1 = on. Unset = off when the GNOME indicator extension
# is enabled, on otherwise.
# HYUSK_ORB=0
# Temporary screenshot retention: delete files older than this many seconds,
# and keep at most this many files.
HYUSK_SCREENSHOT_RETENTION_SECS=900
HYUSK_SCREENSHOT_MAX_FILES=30
# Long model-driven turns may use this many model/tool rounds and this much
# wall-clock time. Identical tool rounds are stopped early to prevent loops.
HYUSK_AGENT_MAX_TOOL_ROUNDS=24
HYUSK_AGENT_MAX_TURN_SECS=600
HYUSK_AGENT_MAX_REPEATED_TOOL_ROUNDS=3

# Optional local voice assets. Wake detection is skipped when the model is
# missing, and STT falls back to text-only mode when its model cannot load.
WAKE_WORD_ENABLED=1
WAKE_WORD_MODEL=models/hey_hyusk.onnx
# Optional comma-separated list. When set, every model is loaded and scored,
# and the highest confidence wins.
# WAKE_WORD_MODELS=models/hey_hyusk.onnx,models/hey_livekit.onnx
# Lower for more sensitivity, raise for fewer false positives.
WAKE_WORD_THRESHOLD=0.93
# One score at or above this confidence wakes immediately.
WAKE_WORD_STRONG_THRESHOLD=0.94
# Number of qualifying scores required. One keeps response latency low.
WAKE_WORD_MIN_HITS=1
WAKE_WORD_HIT_WINDOW_MS=1000
# Adaptive noise gate floor. Lower accepts quieter/farther speech.
WAKE_WORD_MIN_RMS=0.003
# Minimum time between detections in milliseconds.
WAKE_WORD_COOLDOWN_MS=1500
# Personal models from train-wake-word.py use raw speech-band audio. Enable
# RNNoise only when the model was trained with the same preprocessing.
WAKE_WORD_DENOISE=0
# How often (ms) the buffered audio is re-scored. Lower wakes faster, costs CPU.
WAKE_WORD_STEP_MS=200

# Hand-clap wake: no model needed, woken instantly (<100 ms) by a sharp clap.
# Disabled by default because background noise (doors, coughs, desk bumps)
# triggers it. Set to 1 to opt back in.
# Set WAKE_DEBUG=1 to print live level/gate/score diagnostics for tuning.
WAKE_CLAP_ENABLED=0
# A clap must be this many times louder than recent background level.
WAKE_CLAP_SENSITIVITY=6.0
# Minimum peak amplitude (0..1) required for a clap. Raise to ignore soft knocks.
WAKE_CLAP_MIN_PEAK=0.03

# If models/hey_hyusk.onnx is absent, models/hey_livekit.onnx is used when
# present. scripts/download-wake-word.sh also fetches an "alexa" classifier,
# and scripts/train-wake-word.py can build models/hey_<word>.onnx for your
# own voice (e.g. "ragna").
STT_MODEL=models/ggml-base.en.bin
# Whisper language code: en, hi, bn, gu, kn, ml, mr, or, pa, ta, te, ur,
# ne, or auto. Use a multilingual model (not a file ending in .en) for these.
STT_LANGUAGE=en
# RNNoise suppression for the recorded command. This is independent from the
# wake-word preprocessing setting above and is enabled by default.
STT_DENOISE=1

# Optional on Linux. The bundled Piper model is used when this is unset.
# PIPER_MODEL=models/en_US-lessac-medium.onnx
# Optional speaker name or numeric ID for multi-speaker Piper models.
# PIPER_SPEAKER=87

# Optional private profile for the butler persona. Keep real values in .env.
# HYUSK_USER_NAME=Goutam Sharma
# HYUSK_USER_TITLE=Sir
# HYUSK_USER_AGE=23
# HYUSK_USER_GENDER=male
# HYUSK_USER_CITY=Jaipur
# HYUSK_USER_UNIVERSITY=Poornima University
# HYUSK_USER_PROGRAM=B.Tech CSE

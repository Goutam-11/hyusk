# Copy this file to .env or export these variables in your shell.
# .env is ignored by Git and must not contain a committed API key.

OPENROUTER_API_KEY=
# Optional. Enables Brave Search API; without it, native search uses the
# keyless DuckDuckGo HTML endpoint.
# BRAVE_SEARCH_API_KEY=
# Fast paid, tool-capable model for low-latency voice turns. Free tiers are
# often queued and add seconds. Alternatives: google/gemini-2.0-flash-001,
# anthropic/claude-3.5-haiku, groq/llama-3.3-70b-versatile.
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# A streamed reply is bounded by silence between chunks, not by its total
# length, so a long answer that keeps producing tokens is never cut mid-reply.
# HYUSK_STREAM_IDLE_TIMEOUT_SECS fails the reply when no data arrives for this
# long; raise it for a provider that is slow to produce the next token.
# HYUSK_STREAM_TOTAL_TIMEOUT_SECS caps one streamed reply; 0 disables the cap
# and leaves the idle window as the only bound.
HYUSK_STREAM_IDLE_TIMEOUT_SECS=45
HYUSK_STREAM_TOTAL_TIMEOUT_SECS=600
# Optional Amazon Bedrock API key. The desktop indicator menus (GNOME API keys
# submenu or the Noctalia gear panel) can save it in the login keyring instead,
# with no service restart. Bedrock model browsing uses the OpenAI-compatible Mantle
# endpoint, which exposes /models; choose a model available in this region.
# BEDROCK_API_KEY=
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL=openai.gpt-oss-20b
# Set to 0 for text-only models. When enabled, screenshots are attached to the
# next model turn as images instead of relying on OCR.
MODEL_VISION=1
# When 1, the orb requests keyboard focus while active. This can steal focus
# from the app the agent is controlling, so it defaults to 0.
ORB_STEAL_FOCUS=0
# Orb window: 0 = off, 1 = on. Unset = off when the GNOME indicator extension
# is enabled, on otherwise.
# HYUSK_ORB=0
# Temporary screenshot retention: delete files older than this many seconds,
# and keep at most this many files.
HYUSK_SCREENSHOT_RETENTION_SECS=900
HYUSK_SCREENSHOT_MAX_FILES=30
# Long model-driven turns may use this many model/tool rounds and this much
# wall-clock time. Identical tool rounds are stopped early to prevent loops.
HYUSK_AGENT_MAX_TOOL_ROUNDS=128
HYUSK_AGENT_MAX_TURN_SECS=1800
HYUSK_AGENT_MAX_REPEATED_TOOL_ROUNDS=3
# Maximum serialized model history before old complete turns and verbose tool
# output are compacted. Defaults to a budget derived from the selected model's
# context window (16-120 KB); set this to override it, for example for a local
# model with a small configured context. Recent plain conversation is also
# persisted separately.
# HYUSK_AGENT_MAX_HISTORY_BYTES=120000
# Optional override. Defaults to ~/.local/share/hyusk/session.json.
# HYUSK_SESSION_PATH=/home/you/.local/share/hyusk/session.json

# Optional Android companion link. Only a build with --features mobile has the
# link server, the pairing file, and the model-facing `mobile` tool (P5). Run
# scripts/setup-mobile-link.sh once, then copy the printed paths here. Bind
# 0.0.0.0 only on a trusted LAN/Tailscale interface and restrict port 4488 with
# the Fedora firewall.
# HYUSK_LINK_ENABLED=1
# HYUSK_LINK_BIND=0.0.0.0:4488
# HYUSK_LINK_ADVERTISE_HOST=192.168.1.10
# HYUSK_LINK_TLS_CERT=/home/you/.local/share/hyusk/link/server.crt
# HYUSK_LINK_TLS_KEY=/home/you/.local/share/hyusk/link/server.key
# HYUSK_LINK_MAX_CLIENTS=4

# Optional local voice assets. Wake detection is skipped when the model is
# missing, and STT falls back to text-only mode when its model cannot load.
WAKE_WORD_ENABLED=1
WAKE_WORD_MODEL=models/hey_hyusk.onnx
# Optional comma-separated list. When set, every model is loaded and scored,
# and the highest confidence wins.
# WAKE_WORD_MODELS=models/hey_hyusk.onnx,models/hey_livekit.onnx
# Lower for more sensitivity, raise for fewer false positives.
WAKE_WORD_THRESHOLD=0.93
# One score at or above this confidence wakes immediately.
WAKE_WORD_STRONG_THRESHOLD=0.94
# Number of qualifying scores required. One keeps response latency low.
WAKE_WORD_MIN_HITS=1
WAKE_WORD_HIT_WINDOW_MS=1000
# Adaptive noise gate floor. Lower accepts quieter/farther speech.
WAKE_WORD_MIN_RMS=0.003
# Minimum time between detections in milliseconds.
WAKE_WORD_COOLDOWN_MS=1500
# Personal models from train-wake-word.py use raw speech-band audio. Enable
# RNNoise only when the model was trained with the same preprocessing.
WAKE_WORD_DENOISE=0
# How often (ms) the buffered audio is re-scored. Lower wakes faster, costs CPU.
WAKE_WORD_STEP_MS=200

# Hand-clap wake: no model needed, woken instantly (<100 ms) by a sharp clap.
# Disabled by default because background noise (doors, coughs, desk bumps)
# triggers it. Set to 1 to opt back in.
# Set WAKE_DEBUG=1 to print live level/gate/score diagnostics for tuning.
WAKE_CLAP_ENABLED=0
# A clap must be this many times louder than recent background level.
WAKE_CLAP_SENSITIVITY=6.0
# Minimum peak amplitude (0..1) required for a clap. Raise to ignore soft knocks.
WAKE_CLAP_MIN_PEAK=0.03

# If models/hey_hyusk.onnx is absent, models/hey_livekit.onnx is used when
# present. scripts/download-wake-word.sh also fetches an "alexa" classifier,
# and scripts/train-wake-word.py can build models/hey_<word>.onnx for your
# own voice (e.g. "ragna").
STT_MODEL=models/ggml-base.en.bin
# Whisper language code: en, hi, bn, gu, kn, ml, mr, or, pa, ta, te, ur,
# ne, or auto. Use a multilingual model (not a file ending in .en) for these.
STT_LANGUAGE=en
# Total local Whisper budget, including waiting for the inference worker.
# Cancellation is cooperative; first-time model loading cannot be interrupted.
# The voice runtime also caps recording + transcription at 45 seconds.
HYUSK_STT_TIMEOUT_SECS=30
# RNNoise suppression for the recorded command. This is independent from the
# wake-word preprocessing setting above and is enabled by default.
STT_DENOISE=1
# Optional PipeWire echo-cancel pair for hands-free use on laptop speakers.
# Start it with scripts/ensure-echo-cancel.sh. Both names must be paired.
# For the complete service configuration: scripts/install-autostart.sh --voice-audio
# PIPEWIRE_NODE routes wake/local STT through the same filter as Nova.
# PIPEWIRE_NODE=hyusk_aec_source
# Nova Sonic live voice (P6) is the `sonic` Cargo feature and is off by default:
# a plain build has no AWS SDK, second agent loop, or `bedrock-sonic` provider.
# HYUSK_SONIC_INPUT_DEVICE=hyusk_aec_source
# BEDROCK_SONIC_MODEL=amazon.nova-2-sonic-v1:0
# HYUSK_OUTPUT_DEVICE=hyusk_aec_sink
# PULSE_SINK=hyusk_aec_sink

# Optional on Linux. The bundled Piper model is used when this is unset.
# PIPER_MODEL=models/en_US-lessac-medium.onnx
# Optional speaker name or numeric ID for multi-speaker Piper models.
# PIPER_SPEAKER=87

# Extra terminal applications, comma-separated. Typing and key input ask while a
# focused window is one of these (the built-in list covers common terminals).
# HYUSK_TERMINAL_APPS=myterm,ghostty

# Memory export (M4). Point this at an Obsidian vault to let the `export`
# action write one note per active memory into <vault>/hyusk-notes. Unset means
# the export is unavailable; the agent never writes into a vault on its own.
# HYUSK_MEMORY_VAULT=/home/you/Documents/Vault

# Memory consolidation (M3). A bounded background pass merges near-duplicates
# and decays entries nobody has used for the stale window. `0` turns it off.
# HYUSK_MEMORY_CONSOLIDATE=1
# HYUSK_MEMORY_CONSOLIDATE_STALE_DAYS=180
# HYUSK_MEMORY_CONSOLIDATE_INTERVAL_SECS=21600
# HYUSK_MEMORY_CONSOLIDATE_BUDGET_MS=2000
# HYUSK_MEMORY_MERGE_SIMILARITY=0.90

# Memory retrieval (M2). The per-turn memory block is capped at an estimated
# token count (four characters per token), default 600, highest 4000; 0 stops
# injecting memory entirely. The local feature embedder is always local - no
# provider call - and can be switched off to fall back to FTS-only retrieval.
# HYUSK_MEMORY_PROMPT_TOKENS=600
# HYUSK_MEMORY_EMBEDDINGS=1

# External tool servers (T2). The value is a JSON array, or the path to a file
# holding one, of {"name","command","args"?,"timeout_ms"?,"startup_timeout_ms"?}.
# Each server is spawned once, handshakes its tools, and registers them as
# ext.<server>.<tool>; every external call asks for approval. Unset disables it.
# HYUSK_EXTERNAL_SERVERS=/home/you/.config/hyusk/servers.json

# MCP servers (T3). Servers are listed in $XDG_CONFIG_HOME/hyusk/mcp.json with
# a command, args, an environment allowlist, and an optional tool grant. The
# provider is on when that file exists; 0 disables it, and the refresh interval
# is how often a removed server is noticed without a restart.
# HYUSK_MCP=1
# HYUSK_MCP_CONFIG=/home/you/.config/hyusk/mcp.json
# HYUSK_MCP_REFRESH_SECS=30

# Optional private profile for the butler persona. Keep real values in .env.
# HYUSK_USER_NAME=Goutam Sharma
# HYUSK_USER_TITLE=Sir
# HYUSK_USER_AGE=23
# HYUSK_USER_GENDER=male
# HYUSK_USER_CITY=Jaipur
# HYUSK_USER_UNIVERSITY=Poornima University
# HYUSK_USER_PROGRAM=B.Tech CSE
